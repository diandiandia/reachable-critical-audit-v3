    {
      "sig_id": "SIG-BUFFER-ACCUM-001",
      "semantic": "远端投递数据的无界累积（帧/body/流）在大小校验之前发生",
      "cwe": [
        "CWE-770",
        "CWE-789"
      ],
      "platform_profiles": [
        "server-framework"
      ],
      "detection_hints": {
        "grep": [
          "extend_from_slice",
          "writeFully",
          "readRemaining",
          "\\+\\+= payload",
          "append\\(",
          "writeBytes\\(",
          "bodyBuffer",
          "recv\\(",
          "fread\\(",
          "read\\(",
          "push_back\\("
        ],
        "checklist": [
          "累积点在哪里？",
          "flush/对齐条件是什么（什么事件触发消费/清空）？",
          "大小上限在累积之前还是之后检查？",
          "声明长度与累积量是否独立？"
        ]
      },
      "known_instances": [],
      "empirical_harness": "ws_frame_accum",
      "tier": "L3",
